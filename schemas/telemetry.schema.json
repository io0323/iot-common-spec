{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/io0323/iot-common-spec/schemas/telemetry.schema.json",
  "title": "telemetry：周期的な計測値",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "iot.v1.telemetry"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "readings"
      ],
      "properties": {
        "readings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "value",
              "unit",
              "quality"
            ],
            "properties": {
              "channel": {
                "$ref": "common.schema.json#/$defs/channel"
              },
              "value": {
                "description": "単位そのものを表す数値（第2章）",
                "type": "number"
              },
              "unit": {
                "$ref": "common.schema.json#/$defs/unit"
              },
              "quality": {
                "$ref": "common.schema.json#/$defs/quality"
              }
            }
          }
        },
        "device_state": {
          "description": "任意。デバイス内の状態名（例：UART の TELEMETRY の state をプロファイルの states で名前にしたもの。v0.2.1 で追加）",
          "type": "string"
        },
        "actuators": {
          "description": "任意（第3章）。owner も任意（v0.2.1 #24）",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "level"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/actuator_id"
              },
              "level": {
                "$ref": "common.schema.json#/$defs/level"
              },
              "owner": {
                "$ref": "common.schema.json#/$defs/owner"
              }
            }
          }
        }
      }
    }
  }
}
