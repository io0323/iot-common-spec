{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/io0323/iot-common-spec/schemas/scenario.schema.json",
  "title": "シミュレータのシナリオ（sim/scenarios/*.yaml）",
  "type": "object",
  "required": [
    "name",
    "start",
    "duration_s",
    "devices"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string"
    },
    "start": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "speed": {
      "description": "倍速。省略時は1。0 は待たずに一括生成",
      "type": "number",
      "minimum": 0
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "seed": {
      "type": "integer"
    },
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fault"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "required": [
        "device_id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "$ref": "common.schema.json#/$defs/device_id"
        },
        "type": {
          "enum": [
            "mcu_cpp_01",
            "mcu_c_01",
            "gw_01_lite",
            "app_01"
          ]
        },
        "initial_mode": {
          "type": "string"
        },
        "local_rules": {
          "description": "デバイス自身のルールが出す出力（アクチュエーター → level）。ない出力は既定値 0（owner none）",
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/actuator_id"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/level"
          }
        },
        "signals": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/channel"
          },
          "additionalProperties": {
            "$ref": "#/$defs/signal"
          }
        },
        "thresholds": {
          "description": "mcu_c_01：状態の判定に使うしきい値（0.01℃単位）。省略時は作品01の設計の既定値（warn 4500・crit 6000・hyst 300）",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warn_c100": {
              "type": "integer"
            },
            "crit_c100": {
              "type": "integer"
            },
            "hyst_c100": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "uart_path": {
          "description": "mcu_c_01・gw_01_lite：指定すると、そのデバイスパスを開く（device モード）。mcu_c_01 で省略すると自分で pty を作り、相手が開くパスを表示する",
          "type": "string"
        },
        "reset_reason": {
          "description": "mcu_c_01：BOOT の EVENT の from と DIAG で送る再起動要因（v0.2.2 #38）。省略時は power_on",
          "$ref": "common.schema.json#/$defs/reset_reason"
        },
        "acks_at_s": {
          "description": "mcu_c_01：ボタンの承認（短押し）を行う時刻（開始時刻からの秒数）。CRITICAL・SENSOR_FAULT から戻るのに要る。代役にはボタンがないので、シナリオで与える",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "uart_commands": {
          "description": "gw_01_lite：作品01へ送る指令（UART の上位役）",
          "type": "array",
          "items": {
            "$ref": "#/$defs/uart_command"
          }
        },
        "request_rules": {
          "description": "gw_01_lite：request に返す結果。上から順に照合し、最初に一致したものを使う。どれにも一致しなければ accepted → done",
          "type": "array",
          "items": {
            "$ref": "#/$defs/request_rule"
          }
        },
        "requests": {
          "description": "app_01：送る request",
          "type": "array",
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      }
    },
    "signal": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "constant",
            "diurnal",
            "daylight",
            "soil"
          ]
        },
        "noise": {
          "description": "正規分布のノイズの標準偏差",
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diurnal"
              }
            }
          },
          "then": {
            "required": [
              "mean",
              "amplitude",
              "peak_hour"
            ],
            "properties": {
              "mean": {
                "type": "number"
              },
              "amplitude": {
                "type": "number"
              },
              "peak_hour": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 24
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "daylight"
              }
            }
          },
          "then": {
            "required": [
              "max",
              "sunrise_hour",
              "sunset_hour"
            ],
            "properties": {
              "max": {
                "type": "number",
                "minimum": 0
              },
              "sunrise_hour": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 24
              },
              "sunset_hour": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 24
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "soil"
              }
            }
          },
          "then": {
            "required": [
              "start",
              "decay_per_hour",
              "refill_per_pump_s"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "decay_per_hour": {
                "type": "number",
                "minimum": 0
              },
              "refill_per_pump_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "fault": {
      "type": "object",
      "required": [
        "type",
        "device",
        "at_s"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "sensor_fault",
            "silence",
            "seq_gap",
            "duplicate",
            "clock_skew",
            "corrupt_frame",
            "heartbeat_silence"
          ]
        },
        "device": {
          "$ref": "common.schema.json#/$defs/device_id"
        },
        "at_s": {
          "description": "開始時刻からの秒数",
          "type": "number",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "channel": {
          "$ref": "common.schema.json#/$defs/channel"
        },
        "kind": {
          "enum": [
            "telemetry",
            "event",
            "state",
            "cmd/ack"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "offset_s": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "sensor_fault"
              }
            }
          },
          "then": {
            "required": [
              "channel",
              "duration_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "silence"
              }
            }
          },
          "then": {
            "required": [
              "duration_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "seq_gap",
                  "duplicate"
                ]
              }
            }
          },
          "then": {
            "required": [
              "count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "clock_skew"
              }
            }
          },
          "then": {
            "required": [
              "offset_s",
              "duration_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "corrupt_frame"
              }
            }
          },
          "then": {
            "required": [
              "count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heartbeat_silence"
              }
            }
          },
          "then": {
            "required": [
              "duration_s"
            ]
          }
        }
      ],
      "description": "注入する異常。sensor_fault：channel を duration_s の間 quality fault にし、始まりに SENSOR_FAULT、終わりに SENSOR_RECOVERED を送る（mcu_c_01 は作品01と同じく、終わったあとの承認（acks_at_s）で SENSOR_RECOVERED）。silence：duration_s の間、電文が届かない（seq は進むので受信側から欠損に見える）。seq_gap：at_s 以後の最初の kind（既定 telemetry）の電文の前に seq を count 個飛ばす。duplicate：at_s 以後の最初の kind の電文を、同じ内容（msg_id・seq も同じ）でさらに count 回送る。clock_skew：duration_s の間、ts を offset_s 秒ずらす（ts_source は device のまま）。corrupt_frame：at_s 以後に mcu_c_01 が送る UART フレームのうち count 件の CRC を壊す。heartbeat_silence：gw_01_lite が duration_s の間、作品01への HEARTBEAT を止める"
    },
    "uart_command": {
      "type": "object",
      "required": [
        "at_s",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "at_s": {
          "type": "number",
          "minimum": 0
        },
        "op": {
          "$ref": "common.schema.json#/$defs/op"
        },
        "args": {
          "type": "object"
        },
        "lease_s": {
          "$ref": "common.schema.json#/$defs/lease_s"
        },
        "priority": {
          "enum": [
            "safety",
            "manual",
            "auto",
            "schedule"
          ]
        },
        "repeat": {
          "description": "同じ cmd_ref の CMD をさらにこの回数すぐに送る（重複 cmd_ref の確認用）",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "request_rule": {
      "type": "object",
      "required": [
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "$ref": "common.schema.json#/$defs/op"
        },
        "target": {
          "$ref": "common.schema.json#/$defs/device_id"
        },
        "actuator": {
          "$ref": "common.schema.json#/$defs/actuator_id"
        },
        "result": {
          "enum": [
            "done",
            "failed",
            "rejected",
            "no_response"
          ]
        },
        "reason": {
          "type": "string"
        },
        "done_after_s": {
          "description": "accepted から最終結果までの秒数（既定 1）",
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "rejected",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "at_s",
        "kind",
        "target",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "at_s": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "manual",
            "schedule"
          ]
        },
        "target": {
          "$ref": "common.schema.json#/$defs/device_id"
        },
        "op": {
          "$ref": "common.schema.json#/$defs/op"
        },
        "args": {
          "type": "object"
        },
        "lease_s": {
          "$ref": "common.schema.json#/$defs/lease_s"
        },
        "schedule_id": {
          "description": "kind: schedule のとき必須。planned_at は送る時刻",
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "required": [
              "schedule_id"
            ]
          }
        }
      ]
    }
  }
}
