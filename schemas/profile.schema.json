{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/io0323/iot-common-spec/schemas/profile.schema.json",
  "title": "デバイスプロファイル（profiles/{device_id}.yaml、v0.2.1 #16）",
  "description": "state の必須項目の補完、UART の状態番号と状態名の対応、汎用指令と UART の op の対応を定める。states のキーは状態番号を10進の文字列にしたもの（YAML の整数キーは読み込み時に文字列にする）",
  "type": "object",
  "required": [
    "device_id",
    "transport",
    "channels",
    "actuators"
  ],
  "additionalProperties": false,
  "properties": {
    "device_id": {
      "$ref": "common.schema.json#/$defs/device_id"
    },
    "transport": {
      "enum": [
        "uart",
        "mqtt"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "channel",
          "unit",
          "period_ms"
        ],
        "additionalProperties": false,
        "properties": {
          "channel": {
            "$ref": "common.schema.json#/$defs/channel"
          },
          "unit": {
            "$ref": "common.schema.json#/$defs/unit"
          },
          "period_ms": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "actuators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "min",
          "max"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/actuator_id"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "max_on_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "modes": {
      "description": "set_mode で取りうる mode の値（v0.2.1 #5）",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "minProperties": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "op",
          "uart_op"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "$ref": "common.schema.json#/$defs/op"
          },
          "target": {
            "$ref": "common.schema.json#/$defs/actuator_id"
          },
          "uart_op": {
            "enum": [
              "SET_FAN_OVERRIDE",
              "CLEAR_OVERRIDE",
              "SET_THRESHOLD",
              "GET_STATUS",
              "GET_DIAG"
            ]
          },
          "args": {
            "description": "UART の引数名 → cmd の args の項目名（例：duty_pm: level）",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ttl_s": {
            "description": "lease_s なら cmd の lease_s（省略時は既定値）を ttl_s に入れる。省略時の ttl_s は open-questions #21",
            "const": "lease_s"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "transport": {
        "const": "uart"
      }
    }
  },
  "then": {
    "required": [
      "states",
      "commands"
    ]
  }
}
