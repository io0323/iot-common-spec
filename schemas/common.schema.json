{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/io0323/iot-common-spec/schemas/common.schema.json",
  "title": "iot-common-spec 共通定義（共通仕様 v0.2）",
  "description": "kind ごとの Schema が参照する共通定義。値は docs/spec.md 第2章・第3章・第5章・第6章に合わせる。",
  "$defs": {
    "ulid": {
      "description": "ULID（Crockford Base32 26文字）。先頭文字は 48 ビット時刻部の上限により 0–7（第2章）",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ts": {
      "description": "UTC の ISO 8601、ミリ秒3桁、末尾 Z（第3章）",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "device_id": {
      "description": "{種別}-{言語}-{連番}。予約済み gw-01・app-01 のように言語部のない形も許す（open-questions #3）",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z][a-z0-9]*)?-[0-9]{2,}$"
    },
    "channel": {
      "description": "計測値のチャネル名。デバイス内で一意の snake_case（第2章）",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "actuator_id": {
      "description": "アクチュエーター名。デバイス内で一意の snake_case（第2章）",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
    },
    "unit": {
      "description": "単位（第2章の単位表）",
      "enum": [
        "degC",
        "pct_rh",
        "pct",
        "level_pm",
        "hPa",
        "lux",
        "bytes",
        "rpm"
      ]
    },
    "quality": {
      "description": "データ品質（第5章）",
      "enum": [
        "good",
        "stale",
        "fault"
      ]
    },
    "severity": {
      "description": "重大度（第6章）",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "event_code": {
      "description": "イベントコード。列挙せず形式（英大文字・数字・アンダースコア）だけを検査する（第6章）",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "level": {
      "description": "アクチュエーター出力 0–1000‰（第2章 level_pm、第3章）。整数とする（open-questions #8）",
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "op": {
      "description": "指令・要求の操作（第3章）",
      "enum": [
        "set_actuator",
        "release",
        "set_mode",
        "set_param",
        "get_status"
      ]
    },
    "boot_id": {
      "description": "起動ごとに変わるID。全デバイスで16進小文字8桁（32ビット）。同じデバイスの前回の起動と高い確率で異なればよく、全体での一意性は求めない（第3章、v0.2.1 で確定）",
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "lease_s": {
      "description": "リース秒数。省略可で、省略時は既定60秒とみなす。上限600秒。意味を持つのは set_actuator だけで、他の op に付いた lease_s は無視する（範囲の検査も set_actuator のときだけ。第4章、v0.2.1 で確定）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "op_args": {
      "description": "op ごとの検査（第3章、v0.2.1 #5）。set_actuator は args.id・args.level が必須で lease_s の範囲を検査する。release は args.id、set_mode は args.mode（文字列。取りうる値はデバイスプロファイルの modes）が必須。get_status は引数なし。set_param の引数は未定義。set_actuator 以外の lease_s は無視する（#13）",
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "set_actuator"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "id",
                  "level"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/actuator_id"
                  },
                  "level": {
                    "$ref": "#/$defs/level"
                  }
                }
              },
              "lease_s": {
                "$ref": "#/$defs/lease_s"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "release"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/actuator_id"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set_mode"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cmd_reason": {
      "description": "cmd/ack の reason（第3章）",
      "enum": [
        "unsafe",
        "invalid_arg",
        "unknown_op",
        "unknown_target",
        "expired",
        "busy",
        "internal"
      ]
    },
    "envelope": {
      "description": "共通エンベロープ（第3章）。未知の項目は許可する（第1章「版の方針」）",
      "type": "object",
      "required": [
        "schema",
        "msg_id",
        "device_id",
        "seq",
        "boot_id",
        "ts",
        "ts_source",
        "payload"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^iot\\.v1\\.[a-z][a-z_]*$"
        },
        "msg_id": {
          "$ref": "#/$defs/ulid"
        },
        "device_id": {
          "$ref": "#/$defs/device_id"
        },
        "seq": {
          "$ref": "#/$defs/uint32"
        },
        "boot_id": {
          "$ref": "#/$defs/boot_id"
        },
        "ts": {
          "$ref": "#/$defs/ts"
        },
        "ts_source": {
          "enum": [
            "device",
            "gateway"
          ]
        },
        "payload": {
          "type": "object"
        },
        "uptime_ms": {
          "$ref": "#/$defs/uint32"
        }
      }
    },
    "owner": {
      "description": "出力の持ち主（v0.2.1 #10・#24）。interlock＝デバイスの安全制限が効いている、safety〜schedule＝03 の指令のリース中でその priority、local＝デバイス自身のルールや本体ボタン、none＝既定値",
      "enum": [
        "interlock",
        "safety",
        "manual",
        "auto",
        "schedule",
        "local",
        "none"
      ]
    }
  }
}
