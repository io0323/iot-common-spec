{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/io0323/iot-common-spec/schemas/event.schema.json",
  "title": "event：異常・復旧・状態変化",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "iot.v1.event"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "code",
        "severity"
      ],
      "properties": {
        "code": {
          "$ref": "common.schema.json#/$defs/event_code"
        },
        "severity": {
          "$ref": "common.schema.json#/$defs/severity"
        },
        "message": {
          "type": "string"
        },
        "channel": {
          "$ref": "common.schema.json#/$defs/channel"
        },
        "value": {
          "type": "number"
        },
        "detail": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "description": "BOOT の detail.reset_reason は再起動要因の列挙（v0.2.2 #38）。省略してよい（v0.2.1 の電文は from_state・to_state を持つ）",
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "BOOT"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "properties": {
                  "reset_reason": {
                    "$ref": "common.schema.json#/$defs/reset_reason"
                  }
                }
              }
            }
          }
        },
        {
          "description": "RULE_FIRED の detail は {rule_id, message?}（v0.2.3 #47）。重大度は info〜critical（ルールの notify の level）",
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "RULE_FIRED"
              }
            }
          },
          "then": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "type": "object",
                "required": [
                  "rule_id"
                ],
                "properties": {
                  "rule_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "description": "SYSTEM_MODE_CHANGED の detail は {from, to, reason}（v0.2.3 #48）。from・to は NORMAL・ALERT・EMERGENCY で必須。reason は文字列（ルールの rule_id、approved_by_request、approved_by_gwctl）。重大度は遷移先で決める（NORMAL info・ALERT warning・EMERGENCY critical）が、Schema では検査しない",
          "if": {
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "const": "SYSTEM_MODE_CHANGED"
              }
            }
          },
          "then": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "$ref": "#/$defs/system_mode"
                  },
                  "to": {
                    "$ref": "#/$defs/system_mode"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "system_mode": {
      "description": "作品03（gw-01）のシステムのモード（v0.2.3 #48。profiles/gw-01.yaml の modes）",
      "enum": [
        "NORMAL",
        "ALERT",
        "EMERGENCY"
      ]
    }
  }
}
